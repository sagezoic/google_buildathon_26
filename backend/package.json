{
  "name": "realdha-backend",
  "version": "1.0.0",
  "description": "Backend API service for Realdha built with Bun and Elysia",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "scrape": "bun run src/scraper/run.ts"
  },
  "keywords": [
    "realdha",
    "cloud-run",
    "api",
    "bun",
    "elysia"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@elysiajs/cors": "^1.4.3",
    "@elysiajs/swagger": "^1.3.1",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.32"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  }
}
