# Server Configuration
PORT=8080
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration (Postgres 17 via local Docker or Cloud SQL)
DATABASE_URL=postgres://realdha:realdha@localhost:5432/realdha

# Scraper Configuration
SCRAPER_DELAY_MS=1000

# Google Cloud Storage Configuration
GCP_PROJECT_ID=trusty-bearing-515217-f0
GCS_BUCKET_NAME=realdha-storage-trusty-bearing-515217-f0
GOOGLE_APPLICATION_CREDENTIALS=./gcp-sa-key.json
# Alternative inline credentials (e.g. for CI / Cloud environments):
# GCP_SERVICE_ACCOUNT_KEY=
# GCS_CLIENT_EMAIL=realdha-backend-sa@trusty-bearing-515217-f0.iam.gserviceaccount.com
# GCS_PRIVATE_KEY=

# Document AI (Enterprise Document OCR processor) and Cloud Translation
DOCAI_LOCATION=us
DOCAI_PROCESSOR_ID=
TRANSLATE_LOCATION=global
MAX_UPLOAD_MB=20

# Gemini on Vertex AI: document checks and property chat (aiplatform.googleapis.com)
VERTEX_LOCATION=us-central1
GEMINI_VERIFY_MODEL=gemini-3.8-flash
GEMINI_CHAT_MODEL=gemini-3.8-flash

# Blockchain property tokens (see ../docs/blockchain.md)
# Local chain: `npx ganache --wallet.deterministic` then `bun run chain:deploy` and paste the address below.
CHAIN_NETWORK=ganache
CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_CONTRACT_ADDRESS=
# Local dev signer (ignored when NODE_ENV=production). Production signs with Cloud KMS via CHAIN_KMS_KEY.
CHAIN_PRIVATE_KEY=0x4f3edf983ac636a65a842ce7c78d9aa706d3b113bce9c46f30d7d21715b23b1d
# CHAIN_KMS_KEY=projects/<project>/locations/us-central1/keyRings/realdha-chain/cryptoKeys/property-registrar/cryptoKeyVersions/1
CHAIN_OWNER_SALT=change-me
# Required in production: lawyer console sends it as "Authorization: Bearer <token>"
# CHAIN_ADMIN_TOKEN=
# CHAIN_EXPLORER_URL=https://sepolia.etherscan.io
# PUBLIC_API_URL=http://localhost:8080
