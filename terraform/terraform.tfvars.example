# ------------------------------------------------------------------------------
# Google Cloud Configuration
# ------------------------------------------------------------------------------

# Required: Replace with your Google Cloud Project ID
project_id = "your-gcp-project-id"

# US Region for deployment (e.g. us-central1, us-east1, us-west1, us-east4)
region = "us-central1"

# Environment tag
environment = "prod"

# Enable APIs automatically
enable_apis = true
create_artifact_registry = true

# ------------------------------------------------------------------------------
# Frontend (UI) Service Configuration
# ------------------------------------------------------------------------------

service_name                = "realdha-ui"
artifact_registry_repo_name = "realdha-ui"
container_port              = 8080
allow_unauthenticated       = true
min_instance_count          = 0
max_instance_count          = 10
cpu                         = "1000m"
memory                      = "512Mi"

# Optional: Specific UI container image URI. Defaults to latest in Artifact Registry if empty.
ui_container_image = ""

# ------------------------------------------------------------------------------
# Backend Service Configuration
# ------------------------------------------------------------------------------

deploy_backend                      = true
backend_service_name                = "realdha-backend"
backend_artifact_registry_repo_name = "realdha-backend"
backend_container_port              = 8080
backend_allow_unauthenticated       = true
backend_min_instance_count          = 0
backend_max_instance_count          = 10
backend_cpu                         = "1000m"
backend_memory                      = "512Mi"

# Optional: Specific Backend container image URI. Defaults to latest in Artifact Registry if empty.
backend_container_image = ""

# ------------------------------------------------------------------------------
# Cloud SQL PostgreSQL Configuration
# ------------------------------------------------------------------------------

deploy_database         = true
db_instance_name        = "" # Leave empty for auto-generated realdha-postgres-<suffix>
db_version              = "POSTGRES_16"
db_edition              = "ENTERPRISE" # ENTERPRISE (supports db-f1-micro, db-custom-*) or ENTERPRISE_PLUS
db_tier                 = "db-f1-micro" # db-f1-micro for dev/hackathon, db-custom-1-3840 for prod
db_name                 = "realdha"
db_user                 = "realdha"
db_password             = "" # Leave empty to auto-generate a secure random password
db_disk_size            = 10
db_disk_type            = "PD_SSD"
db_availability_type    = "ZONAL"
db_deletion_protection  = false
db_backup_enabled       = true

# Direct access for local dev (0.0.0.0/0 allowed by default; restrict to your IP for prod)
db_authorized_networks = [
  {
    name = "all"
    cidr = "0.0.0.0/0"
  }
]

# Document AI OCR processor configuration and the existing property-documents bucket
create_docai_processor = true # set to false if creating outside Terraform or lacking documentai.admin role
docai_processor_id     = ""   # specify existing processor ID if already created
docai_location         = "us"
gcs_bucket_name        = ""   # e.g. realdha-storage-<project-id>; leave empty to skip bucket IAM

# Pub/Sub (document-ingest, chain-anchor, analytics-events + dead-letter). With gcs_bucket_name set,
# every upload to that bucket is published to the document-ingest topic.
enable_pubsub = true

# BigQuery analytics dataset; analytics-events is streamed into <dataset>.pubsub_events
enable_bigquery              = true
bigquery_dataset_id          = "realdha_analytics"
bigquery_location            = "US" # US multi-region or a us-* region
bigquery_deletion_protection = false

# Public assets bucket behind Cloud CDN (global load balancer; bills a forwarding rule while it exists)
enable_cdn       = true
cdn_bucket_name  = ""    # empty = realdha-cdn-<project-id>
cdn_domain       = ""    # e.g. cdn.example.com for HTTPS; point its A record at the cdn_ip_address output
cdn_cors_origins = ["*"]

# Blockchain property tokens (see docs/blockchain.md). The registrar key is created in Cloud KMS automatically.
enable_chain           = true
chain_network          = "sepolia"
chain_contract_address = ""   # fill in after `bun run chain:deploy`
chain_explorer_url     = "https://sepolia.etherscan.io"
chain_public_api_url   = ""   # backend Cloud Run URL, used in token metadata links
chain_rpc_url          = ""   # secret; better passed as TF_VAR_chain_rpc_url
chain_admin_token      = ""   # secret; TF_VAR_chain_admin_token
chain_owner_salt       = ""   # secret; TF_VAR_chain_owner_salt
